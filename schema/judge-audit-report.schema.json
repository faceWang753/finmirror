{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facewang753.github.io/finmirror/schema/judge-audit-report.schema.json",
  "title": "FinMirror checklist-verifier audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "judge_audit_schema_version",
    "system_name",
    "method",
    "metrics",
    "hard_gate_checks",
    "scenarios",
    "pairs",
    "claim_boundary"
  ],
  "properties": {
    "judge_audit_schema_version": {"const": "1.0"},
    "system_name": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "metrics": {"$ref": "#/$defs/metrics"},
    "hard_gate_checks": {"$ref": "#/$defs/hard_gate_checks"},
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/scenario_result"}
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pair_result"}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "boolean_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "boolean"}
    },
    "number_map": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_count",
        "pair_count",
        "exact_coverage_rate",
        "overlap_free_rate",
        "atomic_checklist_rate",
        "item_accuracy",
        "item_brier",
        "false_pass_rate",
        "mean_reward_inflation",
        "max_reward_inflation",
        "metamorphic_pass_rate",
        "hard_gate_pass"
      ],
      "properties": {
        "scenario_count": {"type": "integer", "minimum": 2},
        "pair_count": {"type": "integer", "minimum": 1},
        "exact_coverage_rate": {"$ref": "#/$defs/rate"},
        "overlap_free_rate": {"$ref": "#/$defs/rate"},
        "atomic_checklist_rate": {"$ref": "#/$defs/rate"},
        "item_accuracy": {"$ref": "#/$defs/rate"},
        "item_brier": {"$ref": "#/$defs/rate"},
        "false_pass_rate": {"$ref": "#/$defs/rate"},
        "mean_reward_inflation": {"type": "number"},
        "max_reward_inflation": {"type": "number"},
        "metamorphic_pass_rate": {"$ref": "#/$defs/rate"},
        "hard_gate_pass": {"type": "boolean"}
      }
    },
    "hard_gate_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_checklists_exact_atomic_nonoverlapping",
        "all_items_classified_correctly",
        "no_false_requirement_passes",
        "item_brier_at_most_0_10",
        "all_metamorphic_relations_pass"
      ],
      "properties": {
        "all_checklists_exact_atomic_nonoverlapping": {"type": "boolean"},
        "all_items_classified_correctly": {"type": "boolean"},
        "no_false_requirement_passes": {"type": "boolean"},
        "item_brier_at_most_0_10": {"type": "boolean"},
        "all_metamorphic_relations_pass": {"type": "boolean"}
      }
    },
    "item_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "covers",
        "truth",
        "probability",
        "predicted_pass",
        "correct",
        "brier"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "truth": {"type": "boolean"},
        "probability": {"$ref": "#/$defs/rate"},
        "predicted_pass": {"type": "boolean"},
        "correct": {"type": "boolean"},
        "brier": {"$ref": "#/$defs/rate"}
      }
    },
    "scenario_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "relation",
        "reference_scenario_id",
        "requirement_count",
        "checklist_item_count",
        "truth_completion",
        "soft_reward",
        "reward_inflation",
        "checks",
        "items",
        "structure_pass"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "relation": {
          "enum": ["reference", "atomic_omission", "irrelevant_context", "reorder"]
        },
        "reference_scenario_id": {"type": ["string", "null"]},
        "requirement_count": {"type": "integer", "minimum": 1},
        "checklist_item_count": {"type": "integer", "minimum": 1},
        "truth_completion": {"$ref": "#/$defs/rate"},
        "soft_reward": {"$ref": "#/$defs/rate"},
        "reward_inflation": {"type": "number"},
        "checks": {"$ref": "#/$defs/boolean_map"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/item_result"}
        },
        "structure_pass": {"type": "boolean"}
      }
    },
    "pair_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_scenario_id",
        "transformed_scenario_id",
        "relation",
        "changed_requirements",
        "probability_deltas",
        "reward_delta",
        "checks",
        "passed"
      ],
      "properties": {
        "reference_scenario_id": {"type": "string", "minLength": 1},
        "transformed_scenario_id": {"type": "string", "minLength": 1},
        "relation": {"enum": ["atomic_omission", "irrelevant_context", "reorder"]},
        "changed_requirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "probability_deltas": {"$ref": "#/$defs/number_map"},
        "reward_delta": {"type": "number"},
        "checks": {"$ref": "#/$defs/boolean_map"},
        "passed": {"type": "boolean"}
      }
    }
  }
}
