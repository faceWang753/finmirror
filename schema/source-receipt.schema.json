{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finmirror.dev/schema/source-receipt.schema.json",
  "title": "FinMirror Source Receipt",
  "description": "A provenance and release-gating record for one candidate or captured source artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "provider",
    "resource_id",
    "source_url",
    "terms_url",
    "license_id",
    "license_name",
    "attribution",
    "languages",
    "media_type",
    "redistribution",
    "third_party_status",
    "record_state",
    "retrieved_at",
    "as_of",
    "content_sha256",
    "content_bytes",
    "terms_checked_at",
    "terms_snapshot_sha256",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "provider": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "terms_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "license_id": {"type": "string", "minLength": 1},
    "license_name": {"type": "string", "minLength": 1},
    "attribution": {"type": "string", "minLength": 1},
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      }
    },
    "media_type": {"type": "string", "pattern": "^[^\\s/]+/[^\\s/]+$"},
    "redistribution": {
      "type": "string",
      "enum": ["redistribute", "fetch_only", "undetermined"]
    },
    "third_party_status": {
      "type": "string",
      "enum": ["clear", "excluded", "unresolved", "not_reviewed"]
    },
    "record_state": {
      "type": "string",
      "enum": ["candidate", "captured", "blocked"]
    },
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "as_of": {"type": ["string", "null"], "format": "date"},
    "content_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_bytes": {"type": ["integer", "null"], "minimum": 0},
    "terms_checked_at": {"type": "string", "format": "date"},
    "terms_snapshot_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "content_bytes": {"type": "integer", "minimum": 0}
          }
        },
        {
          "properties": {
            "content_sha256": {"type": "null"},
            "content_bytes": {"type": "null"}
          }
        }
      ]
    },
    {
      "if": {
        "properties": {"record_state": {"const": "candidate"}},
        "required": ["record_state"]
      },
      "then": {
        "properties": {
          "retrieved_at": {"type": "null"},
          "content_sha256": {"type": "null"},
          "content_bytes": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"record_state": {"const": "captured"}},
        "required": ["record_state"]
      },
      "then": {
        "properties": {
          "retrieved_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  ]
}
