{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faceWang753/finmirror/schema/equivalence-assurance.schema.json",
  "title": "FinMirror positive equivalence assurance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "equivalence_schema_version",
    "dataset_sha256",
    "baseline",
    "method",
    "relation_count",
    "semantic_assertion_count",
    "passed_count",
    "passed",
    "negative_control",
    "relations",
    "claim_boundary"
  ],
  "properties": {
    "equivalence_schema_version": {"const": "1.0"},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "method": {"type": "string", "minLength": 1},
    "relation_count": {"type": "integer", "minimum": 1},
    "semantic_assertion_count": {"type": "integer", "minimum": 1},
    "passed_count": {"type": "integer", "minimum": 0},
    "passed": {"type": "boolean"},
    "negative_control": {"$ref": "#/$defs/negativeControl"},
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/relation"}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "uses_gold"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "uses_gold": {"type": "boolean"}
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "deliberately_brittle",
        "rejected_relation_count",
        "rejection_rate",
        "purpose"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "deliberately_brittle": {"const": true},
        "rejected_relation_count": {"type": "integer", "minimum": 0},
        "rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "description",
        "declared_fields",
        "eligible_case_count",
        "changed_case_count",
        "affected_pair_count",
        "affected_parallel_group_count",
        "semantic_assertion_count",
        "case_score_preserved_count",
        "semantic_key_preserved_count",
        "pair_result_preserved_count",
        "parallel_result_preserved_count",
        "raw_equality_rejection_count",
        "checks",
        "passed"
      ],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string", "minLength": 1},
        "declared_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "eligible_case_count": {"type": "integer", "minimum": 1},
        "changed_case_count": {"type": "integer", "minimum": 0},
        "affected_pair_count": {"type": "integer", "minimum": 0},
        "affected_parallel_group_count": {"type": "integer", "minimum": 0},
        "semantic_assertion_count": {"type": "integer", "minimum": 1},
        "case_score_preserved_count": {"type": "integer", "minimum": 0},
        "semantic_key_preserved_count": {"type": "integer", "minimum": 0},
        "pair_result_preserved_count": {"type": "integer", "minimum": 0},
        "parallel_result_preserved_count": {"type": "integer", "minimum": 0},
        "raw_equality_rejection_count": {"type": "integer", "minimum": 0},
        "checks": {"$ref": "#/$defs/checks"},
        "passed": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_cases_changed",
        "only_declared_fields_changed",
        "case_scores_preserved",
        "semantic_keys_preserved",
        "pair_results_preserved",
        "parallel_results_preserved",
        "raw_equality_control_rejected"
      ],
      "properties": {
        "eligible_cases_changed": {"type": "boolean"},
        "only_declared_fields_changed": {"type": "boolean"},
        "case_scores_preserved": {"type": "boolean"},
        "semantic_keys_preserved": {"type": "boolean"},
        "pair_results_preserved": {"type": "boolean"},
        "parallel_results_preserved": {"type": "boolean"},
        "raw_equality_control_rejected": {"type": "boolean"}
      }
    }
  }
}
